# ============================================================
# FabPilot configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All keys are read with the `FABPILOT_` prefix.
# ============================================================

# ---------- LLM (OpenAI-compatible API; default: DeepSeek) ----------
FABPILOT_LLM_PROVIDER=openai_compatible      # openai_compatible | fake
FABPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
FABPILOT_LLM_API_KEY=
FABPILOT_LLM_MODEL=deepseek-chat
FABPILOT_LLM_TEMPERATURE=0.2
FABPILOT_LLM_MAX_TOKENS=2048

# ---------- Embedding (RAG) ----------
# openai_compatible  -> call a real embedding endpoint
# hash               -> deterministic offline embedding (no network, for tests/dev)
FABPILOT_EMBEDDING_PROVIDER=hash
FABPILOT_EMBEDDING_BASE_URL=https://api.deepseek.com/v1
FABPILOT_EMBEDDING_API_KEY=
FABPILOT_EMBEDDING_MODEL=text-embedding-3-small
FABPILOT_EMBEDDING_DIM=1024

# ---------- Business database ----------
# Production: PostgreSQL (see docker-compose.yml). For quick local runs
# you may also use SQLite:  sqlite:///./fabpilot.db
FABPILOT_DATABASE_URL=postgresql+psycopg://fabpilot:fabpilot@localhost:5432/fabpilot

# ---------- Vector store ----------
FABPILOT_VECTOR_STORE=memory                   # memory | pgvector
FABPILOT_PGVECTOR_CONNECTION=postgresql+psycopg://fabpilot:fabpilot@localhost:5432/fabpilot

# ---------- ReAct budgets / loop safety ----------
FABPILOT_SUPERVISOR_MAX_ITERATIONS=10
FABPILOT_AGENT_MAX_ITERATIONS=8
FABPILOT_TOOL_BUDGET=30
FABPILOT_LOOP_DETECTION_WINDOW=4

# ---------- Forecasting ----------
FABPILOT_DEFAULT_FORECAST_MODEL=statistical_baseline
FABPILOT_FORECAST_LOOKBACK=96
FABPILOT_FORECAST_HORIZON=16

# ---------- Paths ----------
FABPILOT_KNOWLEDGE_BASE_DIR=knowledge_base
FABPILOT_DATA_DIR=data
FABPILOT_LOG_LEVEL=INFO
